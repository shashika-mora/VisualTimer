#include <winver.h>

#define VT_VERSION     1,0,0,0
#define VT_VERSION_STR "1.0.0"

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    VT_VERSION
PRODUCTVERSION VT_VERSION
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "shashika-mora"
            VALUE "FileDescription",  "Visual Timer - see your time"
            VALUE "FileVersion",      VT_VERSION_STR
            VALUE "InternalName",     "VisualTimer"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "VisualTimer.exe"
            VALUE "ProductName",      "Visual Timer"
            VALUE "ProductVersion",   VT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
